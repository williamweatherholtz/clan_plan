# Force LF for files that are read by tooling that hashes their content
# (sqlx migrations are sha384'd; CRLF on Windows breaks the checksum).
*.sql       text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
Dockerfile  text eol=lf
*.sh        text eol=lf

# Binary / generated — leave alone
*.png       binary
*.jpg       binary
*.svg       binary
*.ico       binary
